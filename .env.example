APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# System A (dash.oacl.co.tz — ManageMyBus.net bus operator dashboard)
SYSTEM_A_BASE_URL=https://dash.oacl.co.tz
SYSTEM_A_USERNAME=
SYSTEM_A_PASSWORD=
SYSTEM_A_HEADLESS=true
DUSK_DRIVER_URL=http://localhost:9515

# System B (ALIASTELLA backend — tenant subdomain + a user with role
# admin/agent/conductor in that tenant; the client logs in at runtime
# via /api/login and caches the Sanctum token it gets back)
SYSTEM_B_TENANT_BASE_URL=
SYSTEM_B_USERNAME=
SYSTEM_B_PASSWORD=

# System B apex (xas.co.tz) — platform_admin login, used only for
# cross-tenant orchestration: listing companies and revealing each
# tenant's System A credentials.
SYSTEM_B_APEX_BASE_URL=
SYSTEM_B_PLATFORM_ADMIN_USERNAME=
SYSTEM_B_PLATFORM_ADMIN_PASSWORD=
